{
  "name": "fennecmomo-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate": "payload generate:types && payload generate:importmap",
    "setup": "node scripts/setup.mjs",
    "seed": "cross-env NODE_OPTIONS=--import=tsx payload run scripts/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/test-integration.mjs"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "graphql": "^16.11.0",
    "next": "16.4.0",
    "payload": "3.90.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "yauzl": "^3.2.0"
  },
  "overrides": {
    "sass": "1.105.1",
    "undici": "^7.30.0",
    "dompurify": "3.4.16",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^2.10.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
