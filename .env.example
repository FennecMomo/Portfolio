PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters
SERVER_URL=http://localhost:3000
# Must be a separate origin; localhost and 127.0.0.1 are separate cookie hosts.
DEMO_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=file:./storage/portfolio.db
STORAGE_DIR=./storage
# Only used by npm run seed. Set your own password before creating an administrator.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
